    "@eslint/eslintrc": "^3.3.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0",
    "lighthouse": "^12.8.0"
  },
  "packageManager": "pnpm@10.15.1",
