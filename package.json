    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.12.7",
    "lenis": "^1.3.0",
    "framer-motion": "^12.0.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.0.0",
    "react-hook-form": "^7.60.0",
    "zod": "^3.25.0",
    "@hookform/resolvers": "^3.10.0",
