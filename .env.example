# Development stays noindex. Enable only after the business approves real content.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
# Sanity: project ID + dataset from sanity.io. Never use a write token client-side.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_REVALIDATE_SECRET=
# Resend: verified sender/domain, never a fabricated address
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
# HTTPS endpoint must persist lead then acknowledge {"ok":true}
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# Optional WhatsApp Business notification adapter, never publicly exposed
WHATSAPP_NOTIFICATION_WEBHOOK_URL=
WHATSAPP_NOTIFICATION_SECRET=
# Optional abuse protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
